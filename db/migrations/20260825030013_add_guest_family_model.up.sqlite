CREATE TABLE parents (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    first_name TEXT NOT NULL,
    last_name TEXT NOT NULL,
    phone TEXT NOT NULL,
    email TEXT NOT NULL,
    created_at DATETIME NOT NULL,
    CHECK (phone <> '' OR email <> '')
);

CREATE TABLE children (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    parent_id INTEGER NOT NULL REFERENCES parents(id),
    first_name TEXT NOT NULL,
    last_name TEXT NOT NULL,
    dob TEXT NOT NULL,
    grade TEXT NOT NULL,
    created_at DATETIME NOT NULL
);

CREATE TABLE guest_submissions (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    public_id TEXT NOT NULL UNIQUE,
    parent_id INTEGER NOT NULL REFERENCES parents(id),
    approved_at DATETIME NULL,
    rejected_at DATETIME NULL,
    entered_at DATETIME NULL,
    created_at DATETIME NOT NULL
);

CREATE INDEX idx_children_parent_id ON children(parent_id);

ALTER TABLE manual_checkins ADD COLUMN child_id INTEGER NULL REFERENCES children(id);

CREATE TABLE manual_checkins_new (
    id INTEGER PRIMARY KEY,
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    public_id TEXT,
    first_name TEXT NOT NULL,
    last_name TEXT NOT NULL,
    checked_out_at DATETIME DEFAULT NULL,
    checked_out_confirmed_at DATETIME DEFAULT NULL,
    child_id INTEGER NULL REFERENCES children(id),
    CHECK (child_id IS NOT NULL OR (first_name <> '' AND last_name <> ''))
);

INSERT INTO manual_checkins_new (id, created_at, public_id, first_name, last_name, checked_out_at, checked_out_confirmed_at, child_id)
SELECT id, created_at, public_id, first_name, last_name, checked_out_at, checked_out_confirmed_at, child_id
FROM manual_checkins;

DROP TABLE manual_checkins;
ALTER TABLE manual_checkins_new RENAME TO manual_checkins;

CREATE INDEX idx_manual_checked_out_at ON manual_checkins (checked_out_at);

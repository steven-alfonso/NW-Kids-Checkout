# Copy to .env and fill in. .env is gitignored; this file is not, so it is the
# one place the expected variable names are recorded.
#
# DB_FILE is deliberately absent. The default (database/kids-checkin.db) already
# matches the Makefile, and a second copy of that path in .env is exactly what
# let the two drift apart before. Set it only to point at a different file.

ENVIRONMENT=dev

PLANNING_CENTER_API_BASE_URL=https://api.planningcenteronline.com
PLANNING_CENTER_API_CLIENT_ID=
PLANNING_CENTER_API_SECRET=

# bcrypt hashes, not plaintext. Generate one with the snippet in README.md
# ("Quick Start", step 1). The username you log in with selects the variable:
# LOGIN_PASSWORD_<USERNAME>, uppercased.
#
# Wrap the hash in single quotes. godotenv expands $VAR inside an unquoted
# value, and a bcrypt hash is mostly $ signs, so unquoted "$2a$10$..." is
# delivered with its prefix eaten. Login then fails with ?error=invalid and
# nothing in the log to explain it. Single quotes are passed through verbatim.
LOGIN_PASSWORD_ADMIN=
LOGIN_PASSWORD_USER=

CHECKOUT_FETCHER_LOOKBACK_TIME=-12h
CHECKOUT_FETCHER_USE_MOCK=true

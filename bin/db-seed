#!/bin/bash

set -euo pipefail

# The Makefile passes the converged database path as $1; $DB_FILE remains as
# a fallback so direct invocations keep working.
DB_FILE="${1:-${DB_FILE:?set DB_FILE or pass the database path as \$1}}"

echo "$DB_FILE"

sqlite3 "$DB_FILE" <<'SQL'
ATTACH 'seed/seed.db' AS seed;

BEGIN;

INSERT OR REPLACE INTO events (id, name, planning_center_id, auto_fetch)
SELECT id, name, planning_center_id, 1
FROM seed.events;

INSERT OR REPLACE INTO location_groups (id, name)
SELECT id, name
FROM seed.location_groups;

INSERT OR REPLACE INTO locations (id, planning_center_id, planning_center_parent_id, location_group_id, event_id, name, auto_fetch, last_checked_out_time)
SELECT id, planning_center_id, planning_center_parent_id, location_group_id, event_id, name, auto_fetch, last_checked_out_time
FROM seed.locations;

INSERT OR REPLACE INTO event_check_windows (id, event_id, start_day_of_week, start_time, end_day_of_week, end_time, timezone)
SELECT id, event_id, start_day_of_week, start_time, end_day_of_week, end_time, timezone
FROM seed.event_check_windows;

COMMIT;
DETACH seed;

SQL

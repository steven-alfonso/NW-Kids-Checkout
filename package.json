{
  "name": "checkout",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "test": "vitest run",
    "test:conformance": "npm run build:checkouts-vue && playwright test",
    "build:css": "tailwindcss -i internal/web/tailwind.input.css -o internal/web/static/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i internal/web/tailwind.input.css -o internal/web/static/css/tailwind.css --watch",
    "build:checkouts-vue": "vite build --config vite.config.mjs",
    "watch:checkouts-vue": "vite build --config vite.config.mjs --watch",
    "test:app": "playwright test --config playwright.app.config.mjs",
    "bench": "node benchmarks/checkouts-bench.mjs --name=vue --bundle=internal/web/static/dist/vue/checkouts.js",
    "bench:cpu4": "node benchmarks/checkouts-bench.mjs --name=vue-cpu4 --bundle=internal/web/static/dist/vue/checkouts.js --cpu=4"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.4",
    "@vitejs/plugin-vue": "6.0.10",
    "jsdom": "^30.1.3",
    "tailwindcss": "4.3.4",
    "vite": "8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "vue": "3.5.44"
  }
}

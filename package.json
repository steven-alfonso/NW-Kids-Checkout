{
  "name": "checkout",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "test": "vitest run",
    "test:conformance": "playwright test",
    "build:css": "tailwindcss -i internal/web/tailwind.input.css -o internal/web/static/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i internal/web/tailwind.input.css -o internal/web/static/css/tailwind.css --watch",
    "build:checkouts-svelte": "vite build --config vite.config.mjs",
    "watch:checkouts-svelte": "vite build --config vite.config.mjs --watch",
    "test:app": "npm run build:checkouts-svelte && playwright test --config playwright.app.config.mjs",
    "bench": "npm run build:checkouts-svelte && node benchmarks/checkouts-bench.mjs --name=svelte --bundle=internal/web/static/dist/svelte/checkouts.js",
    "bench:cpu4": "npm run build:checkouts-svelte && node benchmarks/checkouts-bench.mjs --name=svelte-cpu4 --bundle=internal/web/static/dist/svelte/checkouts.js --cpu=4"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/cli": "4.3.4",
    "jsdom": "^30.1.3",
    "svelte": "5.57.3",
    "tailwindcss": "4.3.4",
    "vite": "8.3.5",
    "vitest": "^5.1.0"
  }
}

{
  "name": "checkout",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "test": "vitest run",
    "test:conformance": "npm run build:checkouts-preact && playwright test",
    "build:css": "tailwindcss -i internal/web/tailwind.input.css -o internal/web/static/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i internal/web/tailwind.input.css -o internal/web/static/css/tailwind.css --watch",
    "build:checkouts-preact": "vite build --config vite.config.mjs",
    "watch:checkouts-preact": "vite build --config vite.config.mjs --watch",
    "test:app": "npm run build:checkouts-preact && playwright test --config playwright.app.config.mjs",
    "bench": "npm run build:checkouts-preact && node benchmarks/checkouts-bench.mjs --name=preact --bundle=internal/web/static/dist/preact/checkouts.js",
    "bench:cpu4": "npm run build:checkouts-preact && node benchmarks/checkouts-bench.mjs --name=preact-cpu4 --bundle=internal/web/static/dist/preact/checkouts.js --cpu=4"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "2.10.6",
    "@tailwindcss/cli": "4.3.4",
    "jsdom": "^30.1.3",
    "tailwindcss": "4.3.4",
    "vite": "8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "preact": "11.1.1"
  }
}
